{
  "name": "babyready",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.2.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.25.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:emulators": "firebase emulators:exec --project babyready-rules-test --only auth,firestore \"npm run test:rules\"",
    "check:production-env": "node scripts/check-production-env.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "clinician-admin": "node scripts/manage-clinician-admin.mjs",
    "seed:early-pregnancy-media": "node scripts/import-early-pregnancy-media.mjs",
    "seed:early-pregnancy-learner-outline": "node scripts/seed-early-pregnancy-learner-outline.mjs",
    "seed:preparing-for-labor-outline": "node scripts/seed-preparing-for-labor-outline.mjs",
    "migrate:first-trimester-content-order": "node scripts/assign-first-trimester-content-order.mjs",
    "check:media-intake-worker": "npm --prefix services/media-intake-worker run check",
    "deploy:media-intake-worker": "node scripts/deploy-media-intake-worker.mjs"
  },
  "private": true
}
