{
  "name": "babyready",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-secure-store": "^57.0.1",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.2.2",
    "firebase-tools": "^15.25.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:emulators": "firebase emulators:exec --project babyready-rules-test --only auth,firestore \"npm run test:rules\"",
    "check:production-env": "node scripts/check-production-env.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "test:lessons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/lessons.test.mjs tests/askSafety.test.mjs"
  },
  "private": true
}
