# Copy this file to .env and fill in values from your Firebase project.
# These values are public Firebase app configuration, not server secrets.
# Do not put Firebase Admin SDK credentials or AI provider API keys in this file.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: connect a development build to the Firebase Local Emulator Suite.
# Use a LAN address instead of 127.0.0.1 when testing on a physical device.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# The Edinburgh Postnatal Depression Scale self-check in lesson 6.4. Leave false
# until written permission from the Royal College of Psychiatrists is confirmed.
EXPO_PUBLIC_ENABLE_EPDS=false

# The full-class purchase. Leave false until the product is set up in App Store
# Connect and RevenueCat. Free lessons are listed in src/lib/access.ts.
EXPO_PUBLIC_ENABLE_PAYWALL=false
# RevenueCat public SDK keys (appl_... and goog_...). These ship inside the app
# and are not secrets. For store builds, set them in eas.json's production env.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
