rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function courseIsPublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.publicationState == 'published';
    }

    function sharedWithCurrentUser() {
      return signedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.guestId == request.auth.uid);
    }

    function inviteOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function inviteGuest() {
      return signedIn() && resource.data.guestId == request.auth.uid;
    }

    function isPublicationState(state) {
      return state in ['draft', 'submitted', 'approved', 'published', 'frozen'];
    }

    function validClinicalContentBlock() {
      return isPublicationState(request.resource.data.publicationState)
        && request.resource.data.mediaIds is list
        && (
          !request.resource.data.keys().hasAny(['displayOrder'])
          || (
            request.resource.data.displayOrder is int
            && request.resource.data.displayOrder > 0
          )
        )
        && (
          request.resource.data.isClinicalClaim != true
          || request.resource.data.publicationState != 'published'
          || (
            request.resource.data.sourceIds is list
            && request.resource.data.sourceIds.size() > 0
            && request.resource.data.clinicalReviewerId is string
            && request.resource.data.lastReviewedAt is timestamp
            && request.resource.data.nextReviewAt is timestamp
          )
        );
    }

    function validSourceRecord() {
      return request.resource.data.id is string
        && request.resource.data.organization is string
        && request.resource.data.title is string
        && request.resource.data.url is string
        && request.resource.data.lastReviewedAt is timestamp
        && request.resource.data.nextReviewAt is timestamp
        && isPublicationState(request.resource.data.publicationState);
    }

    function validClinicalContentVersion(contentBlockId) {
      return request.resource.data.id is string
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber > 0
        && request.resource.data.action in [
          'draft_saved',
          'submitted',
          'approved',
          'published',
          'frozen',
          'order_updated'
        ]
        && request.resource.data.actorId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.contentBlockId == contentBlockId
        && request.resource.data.snapshot.type is string
        && request.resource.data.snapshot.body is string
        && request.resource.data.snapshot.sourceIds is list
        && request.resource.data.snapshot.mediaIds is list
        && request.resource.data.snapshot.isClinicalClaim is bool
        && isPublicationState(request.resource.data.snapshot.publicationState)
        && (
          !request.resource.data.snapshot.keys().hasAny(['displayOrder'])
          || (
            request.resource.data.snapshot.displayOrder is int
            && request.resource.data.snapshot.displayOrder > 0
          )
        );
    }

    function validClinicalMediaRecord(mediaId) {
      return request.resource.data.id == mediaId
        && request.resource.data.title is string
        // These three reviewed assets are bundled static figures. Broader
        // image, audio, and video support will require separate storage and
        // delivery controls before the allowable type set is expanded.
        && request.resource.data.type == 'figure'
        && request.resource.data.assetKey in [
          'early-pregnancy-care-timeline',
          'folic-acid-early-pregnancy',
          'nausea-support-ideas'
        ]
        && request.resource.data.altText is string
        && request.resource.data.sourceIds is list
        && request.resource.data.isClinicalClaim is bool
        && isPublicationState(request.resource.data.publicationState)
        && (
          request.resource.data.isClinicalClaim != true
          || request.resource.data.publicationState != 'published'
          || (
            request.resource.data.sourceIds.size() > 0
            && request.resource.data.clinicalReviewerId is string
            && request.resource.data.lastReviewedAt is timestamp
            && request.resource.data.nextReviewAt is timestamp
          )
        );
    }

    function validComparisonAuditExport(
      courseId,
      moduleId,
      lessonId,
      contentBlockId,
      auditExportId
    ) {
      return request.resource.data.keys().hasOnly([
          'id',
          'courseId',
          'moduleId',
          'lessonId',
          'contentBlockId',
          'baselineVersionId',
          'baselineVersionNumber',
          'comparisonVersionId',
          'comparisonVersionNumber',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt'
        ])
        && request.resource.data.id == auditExportId
        && request.resource.data.courseId == courseId
        && request.resource.data.moduleId == moduleId
        && request.resource.data.lessonId == lessonId
        && request.resource.data.contentBlockId == contentBlockId
        && request.resource.data.baselineVersionId is string
        && request.resource.data.baselineVersionNumber is int
        && request.resource.data.baselineVersionNumber > 0
        && request.resource.data.comparisonVersionId is string
        && request.resource.data.comparisonVersionId != request.resource.data.baselineVersionId
        && request.resource.data.comparisonVersionNumber is int
        && request.resource.data.comparisonVersionNumber > 0
        && request.resource.data.exportFormat == 'pdf'
        && request.resource.data.exportRoute in [
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.exportedBy == request.auth.uid
        && request.resource.data.exportedAt == request.time;
    }

    function validAuditReportManifest(reportId) {
      return request.resource.data.keys().hasAll([
          'id',
          'reportId',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt',
          'filterSnapshot',
          'recordCount',
          'pageCount',
          'auditRecordIds',
          'auditRecordPaths'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'reportId',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt',
          'filterSnapshot',
          'recordCount',
          'pageCount',
          'auditRecordIds',
          'auditRecordPaths'
        ])
        && request.resource.data.id == reportId
        && request.resource.data.reportId == reportId
        && request.resource.data.exportFormat == 'pdf'
        && request.resource.data.exportRoute in [
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.exportedBy == request.auth.uid
        && request.resource.data.exportedAt == request.time
        && request.resource.data.filterSnapshot is map
        && request.resource.data.filterSnapshot.keys().hasAll([
          'scope',
          'clinicianId',
          'exportRoute',
          'startDate',
          'endDate',
          'versionNumber'
        ])
        && request.resource.data.filterSnapshot.keys().hasOnly([
          'scope',
          'clinicianId',
          'exportRoute',
          'startDate',
          'endDate',
          'versionNumber'
        ])
        && request.resource.data.filterSnapshot.scope is string
        && request.resource.data.filterSnapshot.clinicianId is string
        && request.resource.data.filterSnapshot.exportRoute in [
          'all',
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.filterSnapshot.startDate is string
        && request.resource.data.filterSnapshot.endDate is string
        && request.resource.data.filterSnapshot.versionNumber is string
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount > 0
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.auditRecordIds is list
        && request.resource.data.auditRecordIds.size() == request.resource.data.recordCount
        && request.resource.data.auditRecordPaths is list
        && request.resource.data.auditRecordPaths.size() == request.resource.data.recordCount;
    }

    // Collection-group queries need an explicit recursive match even though
    // every individual audit record has an administrator-only nested match.
    // This grants no create, update, or delete capability.
    match /{path=**}/comparisonAuditExports/{auditExportId} {
      allow read: if isAdmin();
    }

    // The clinical review queue uses a collection-group query across all
    // content blocks. Keep this read path administrator-only; learner reads
    // remain governed by the course-specific published-content rule below.
    match /{path=**}/contentBlocks/{contentBlockId} {
      allow read: if isAdmin();
    }

    // Dashboard report manifests preserve the exact immutable audit-record set
    // and original filters behind the report ID printed in the PDF.
    match /auditReportManifests/{reportId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAuditReportManifest(reportId);
      allow update, delete: if false;
    }

    // Clinically reviewed curriculum is write-protected behind a server-side
    // admin workflow. Users may read only currently published material.
    match /courses/{courseId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if courseIsPublished(courseId) || isAdmin();
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if courseIsPublished(courseId) || isAdmin();
          allow write: if isAdmin();

          match /contentBlocks/{contentBlockId} {
            // A course may be published while individual revisions are still
            // in draft or review. Learners see only the blocks that have
            // themselves completed publication; administrators retain full
            // review-queue visibility.
            allow read: if (
              courseIsPublished(courseId)
              && resource.data.publicationState == 'published'
            ) || isAdmin();
            allow write: if isAdmin() && validClinicalContentBlock();

            match /versions/{versionId} {
              allow read: if isAdmin();
              allow create: if isAdmin() && validClinicalContentVersion(contentBlockId);
              allow update, delete: if false;
            }

            match /comparisonAuditExports/{auditExportId} {
              allow read: if isAdmin();
              allow create: if isAdmin()
                && validComparisonAuditExport(
                  courseId,
                  moduleId,
                  lessonId,
                  contentBlockId,
                  auditExportId
                );
              allow update, delete: if false;
            }
          }
        }
      }
    }

    match /sources/{sourceId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin() && validSourceRecord();
    }

    // Clinical figures, images, audio, and video assets have the same
    // published-only learner visibility and administrator-only governance
    // model as clinical source records.
    match /clinicalMedia/{mediaId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin() && validClinicalMediaRecord(mediaId);
    }

    match /clinicalReviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    // All user-owned data stays in a user namespace to make ownership explicit.
    match /users/{userId} {
      allow read, write: if owns(userId);

      match /courseProgress/{progressId} {
        allow read, write: if owns(userId);
      }

      match /planArtifacts/{artifactId} {
        allow read, write: if owns(userId);
      }

      match /careTeamContacts/{contactId} {
        allow read, write: if owns(userId);
      }

      // Safety events should be written only by a trusted server process.
      match /safetyEvents/{eventId} {
        allow read: if owns(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Support sharing is scope-limited and must never open a user’s private
    // health record, private AI chats, or unshared plan artifacts.
    match /supportInvites/{inviteId} {
      allow read: if sharedWithCurrentUser() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.guestId is string;
      // Owners may manage scope and revoke access, but cannot silently replace
      // either party. Guests can only accept or decline their own invitation.
      allow update: if isAdmin()
        || (inviteOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.guestId == resource.data.guestId)
        || (inviteGuest()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt'])
          && request.resource.data.status in ['accepted', 'declined']);
      allow delete: if inviteOwner() || isAdmin();
    }
  }
}
