rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function courseIsPublished(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.publicationState == 'published';
    }

    function sharedWithCurrentUser() {
      return signedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.guestId == request.auth.uid);
    }

    function inviteOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function inviteGuest() {
      return signedIn() && resource.data.guestId == request.auth.uid;
    }

    function validBirthReadinessItems(items) {
      return items is map
        && items.keys().hasAll([
          'careTeamContactConfirmed',
          'afterHoursPlanConfirmed',
          'arrivalLocationConfirmed',
          'transportationPlanDiscussed',
          'supportPersonPlanDiscussed',
          'questionsPrepared'
        ])
        && items.keys().hasOnly([
          'careTeamContactConfirmed',
          'afterHoursPlanConfirmed',
          'arrivalLocationConfirmed',
          'transportationPlanDiscussed',
          'supportPersonPlanDiscussed',
          'questionsPrepared'
        ])
        && items.careTeamContactConfirmed is bool
        && items.afterHoursPlanConfirmed is bool
        && items.arrivalLocationConfirmed is bool
        && items.transportationPlanDiscussed is bool
        && items.supportPersonPlanDiscussed is bool
        && items.questionsPrepared is bool;
    }

    function validBirthReadinessQuestion(question) {
      return question is string
        && question.size() > 0
        && question.size() <= 280
        // Require already-trimmed text. The service trims before saving; rules
        // duplicate the boundary to reject direct malformed writes.
        && question.matches('^\\S(?:[\\s\\S]*\\S)?$');
    }

    function validBirthReadinessQuestions(questions) {
      return questions is list
        && questions.size() <= 10
        && (
          questions.size() == 0
          || (
            validBirthReadinessQuestion(questions[0])
            && (
              questions.size() == 1
              || (
                validBirthReadinessQuestion(questions[1])
                && (
                  questions.size() == 2
                  || (
                    validBirthReadinessQuestion(questions[2])
                    && (
                      questions.size() == 3
                      || (
                        validBirthReadinessQuestion(questions[3])
                        && (
                          questions.size() == 4
                          || (
                            validBirthReadinessQuestion(questions[4])
                            && (
                              questions.size() == 5
                              || (
                                validBirthReadinessQuestion(questions[5])
                                && (
                                  questions.size() == 6
                                  || (
                                    validBirthReadinessQuestion(questions[6])
                                    && (
                                      questions.size() == 7
                                      || (
                                        validBirthReadinessQuestion(questions[7])
                                        && (
                                          questions.size() == 8
                                          || (
                                            validBirthReadinessQuestion(questions[8])
                                            && (
                                              questions.size() == 9
                                              || validBirthReadinessQuestion(questions[9])
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        );
    }

    function validBirthReadinessReflection(reflectionId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['courseId', 'lessonId', 'slideId', 'text', 'updatedAt'])
        && data.keys().hasAll(['courseId', 'lessonId', 'slideId', 'text', 'updatedAt'])
        && data.courseId is string && data.courseId.matches('^[a-z0-9-]{1,80}$')
        && data.lessonId is string && data.lessonId.matches('^[a-z0-9-]{1,80}$')
        && data.slideId is string && data.slideId.matches('^[a-z0-9-]{1,80}$')
        && reflectionId == data.lessonId + '__' + data.slideId
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.updatedAt == request.time;
    }

    function validBirthReadinessBriefData() {
      return request.resource.data.keys().hasOnly([
          'id',
          'courseId',
          'schemaVersion',
          'readinessItems',
          'discussionQuestions',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'courseId',
          'schemaVersion',
          'readinessItems',
          'discussionQuestions',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == 'preparing-for-labor'
        && request.resource.data.courseId == 'preparing-for-labor'
        && request.resource.data.schemaVersion == 1
        && validBirthReadinessItems(request.resource.data.readinessItems)
        && validBirthReadinessQuestions(request.resource.data.discussionQuestions)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isPublicationState(state) {
      return state in ['draft', 'submitted', 'approved', 'published', 'frozen'];
    }

    function validClinicalContentBlock() {
      return isPublicationState(request.resource.data.publicationState)
        // Legacy published cards predate explicit titles. The authoring flow
        // requires a title for all new work, while this optional rule preserves
        // safe review and publication updates for those historical records.
        && (
          !request.resource.data.keys().hasAny(['title'])
          || (
            request.resource.data.title is string
            && request.resource.data.title.size() > 0
          )
        )
        && request.resource.data.mediaIds is list
        && (
          !request.resource.data.keys().hasAny(['displayOrder'])
          || (
            request.resource.data.displayOrder is int
            && request.resource.data.displayOrder > 0
          )
        )
        && (
          request.resource.data.isClinicalClaim != true
          || request.resource.data.publicationState != 'published'
          || (
            request.resource.data.sourceIds is list
            && request.resource.data.sourceIds.size() > 0
            && request.resource.data.clinicalReviewerId is string
            && request.resource.data.lastReviewedAt is timestamp
            && request.resource.data.nextReviewAt is timestamp
          )
        );
    }

    function validSourceRecord() {
      return request.resource.data.id is string
        && request.resource.data.organization is string
        && request.resource.data.title is string
        && request.resource.data.url is string
        && request.resource.data.lastReviewedAt is timestamp
        && request.resource.data.nextReviewAt is timestamp
        && isPublicationState(request.resource.data.publicationState);
    }

    function validMediaIntakeUrl(url) {
      return url is string && url.matches('^https://.+$');
    }

    function validMediaIntakeCreate() {
      return request.resource.data.keys().hasOnly([
          'inputType',
          'originalUrl',
          'transcriptUrl',
          'submitterNote',
          'suggestedTopic',
          'attestedNoPatientInformation',
          'status',
          'submittedBy',
          'submittedAt',
          'updatedAt'
        ])
        && request.resource.data.inputType in ['web_url', 'video_url']
        && validMediaIntakeUrl(request.resource.data.originalUrl)
        && (
          !request.resource.data.keys().hasAny(['transcriptUrl'])
          || validMediaIntakeUrl(request.resource.data.transcriptUrl)
        )
        && request.resource.data.attestedNoPatientInformation == true
        && request.resource.data.status == 'queued'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validMediaIntakeDisposition() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'finalDisposition',
          'decisionNote',
          'decidedBy',
          'decidedAt',
          'updatedAt'
        ])
        && request.resource.data.attestedNoPatientInformation == true
        && request.resource.data.status in ['held', 'rejected', 'archived']
        && request.resource.data.finalDisposition == request.resource.data.status
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() > 0
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validClinicalContentVersion(contentBlockId) {
      return request.resource.data.id is string
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber > 0
        && request.resource.data.action in [
          'draft_saved',
          'submitted',
          'approved',
          'published',
          'frozen',
          'order_updated'
        ]
        && request.resource.data.actorId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.contentBlockId == contentBlockId
        && (
          !request.resource.data.snapshot.keys().hasAny(['title'])
          || (
            request.resource.data.snapshot.title is string
            && request.resource.data.snapshot.title.size() > 0
          )
        )
        && request.resource.data.snapshot.type is string
        && request.resource.data.snapshot.body is string
        && request.resource.data.snapshot.sourceIds is list
        && request.resource.data.snapshot.mediaIds is list
        && request.resource.data.snapshot.isClinicalClaim is bool
        && isPublicationState(request.resource.data.snapshot.publicationState)
        && (
          !request.resource.data.snapshot.keys().hasAny(['displayOrder'])
          || (
            request.resource.data.snapshot.displayOrder is int
            && request.resource.data.snapshot.displayOrder > 0
          )
        );
    }

    function validExternalVideoUrl(url) {
      return url is string
        && (
          url.matches('^https://(www[.])?youtube[.]com/.*$')
          || url.matches('^https://m[.]youtube[.]com/.*$')
          || url.matches('^https://youtu[.]be/.*$')
          || url.matches('^https://(www[.])?vimeo[.]com/.*$')
        );
    }

    function validExternalVideoFields(media) {
      return media.externalUrl is string
        && validExternalVideoUrl(media.externalUrl)
        && media.transcriptUrl is string
        && validExternalVideoUrl(media.transcriptUrl)
        && media.publisher is string
        && media.publisher.size() > 0
        && media.language is string
        && media.language.size() > 0
        && media.durationSeconds is int
        && media.durationSeconds > 0;
    }

    function validClinicalMediaDelivery(media) {
      return (
          media.type == 'figure'
          && media.assetKey in [
            'early-pregnancy-care-timeline',
            'folic-acid-early-pregnancy',
            'nausea-support-ideas',
            'bleeding-during-pregnancy-contact-care',
            'urgent-maternal-warning-signs-get-help-now'
          ]
        )
        || (
          media.type == 'external_video'
          && media.assetKey == 'external-video'
          && validExternalVideoFields(media)
        );
    }

    function validClinicalMediaRecord(mediaId) {
      return request.resource.data.id == mediaId
        && request.resource.data.title is string
        && validClinicalMediaDelivery(request.resource.data)
        && request.resource.data.altText is string
        && request.resource.data.sourceIds is list
        && request.resource.data.isClinicalClaim is bool
        && isPublicationState(request.resource.data.publicationState)
        && (
          request.resource.data.isClinicalClaim != true
          || request.resource.data.publicationState != 'published'
          || (
            request.resource.data.sourceIds.size() > 0
            && request.resource.data.clinicalReviewerId is string
            && request.resource.data.lastReviewedAt is timestamp
            && request.resource.data.nextReviewAt is timestamp
          )
        );
    }

    function validClinicalMediaVersion(mediaId) {
      return request.resource.data.id is string
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber > 0
        && request.resource.data.action in [
          'draft_saved',
          'submitted',
          'approved',
          'published',
          'frozen'
        ]
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.mediaId == mediaId
        && request.resource.data.snapshot.title is string
        && validClinicalMediaDelivery(request.resource.data.snapshot)
        && request.resource.data.snapshot.altText is string
        && request.resource.data.snapshot.sourceIds is list
        && request.resource.data.snapshot.isClinicalClaim is bool
        && isPublicationState(request.resource.data.snapshot.publicationState);
    }

    function validClinicalMediaReview() {
      return request.resource.data.id is string
        && request.resource.data.mediaId is string
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.reviewNotes is string
        && request.resource.data.reviewNotes.size() > 0
        && request.resource.data.versionNumber is int
        && request.resource.data.versionNumber > 0
        && request.resource.data.approvedAt is timestamp
        && exists(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        )
        && get(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        ).data.publicationState == 'submitted'
        && existsAfter(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        )
        && getAfter(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        ).data.publicationState == 'approved'
        && getAfter(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        ).data.clinicalReviewerId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/clinicalMedia/$(request.resource.data.mediaId)
        ).data.versionCount == request.resource.data.versionNumber;
    }

    function validComparisonAuditExport(
      courseId,
      moduleId,
      lessonId,
      contentBlockId,
      auditExportId
    ) {
      return request.resource.data.keys().hasOnly([
          'id',
          'courseId',
          'moduleId',
          'lessonId',
          'contentBlockId',
          'baselineVersionId',
          'baselineVersionNumber',
          'comparisonVersionId',
          'comparisonVersionNumber',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt'
        ])
        && request.resource.data.id == auditExportId
        && request.resource.data.courseId == courseId
        && request.resource.data.moduleId == moduleId
        && request.resource.data.lessonId == lessonId
        && request.resource.data.contentBlockId == contentBlockId
        && request.resource.data.baselineVersionId is string
        && request.resource.data.baselineVersionNumber is int
        && request.resource.data.baselineVersionNumber > 0
        && request.resource.data.comparisonVersionId is string
        && request.resource.data.comparisonVersionId != request.resource.data.baselineVersionId
        && request.resource.data.comparisonVersionNumber is int
        && request.resource.data.comparisonVersionNumber > 0
        && request.resource.data.exportFormat == 'pdf'
        && request.resource.data.exportRoute in [
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.exportedBy == request.auth.uid
        && request.resource.data.exportedAt == request.time;
    }

    function validAuditReportManifest(reportId) {
      return request.resource.data.keys().hasAll([
          'id',
          'reportId',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt',
          'filterSnapshot',
          'recordCount',
          'pageCount',
          'auditRecordIds',
          'auditRecordPaths'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'reportId',
          'exportFormat',
          'exportRoute',
          'exportedBy',
          'exportedAt',
          'filterSnapshot',
          'recordCount',
          'pageCount',
          'auditRecordIds',
          'auditRecordPaths'
        ])
        && request.resource.data.id == reportId
        && request.resource.data.reportId == reportId
        && request.resource.data.exportFormat == 'pdf'
        && request.resource.data.exportRoute in [
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.exportedBy == request.auth.uid
        && request.resource.data.exportedAt == request.time
        && request.resource.data.filterSnapshot is map
        && request.resource.data.filterSnapshot.keys().hasAll([
          'scope',
          'clinicianId',
          'exportRoute',
          'startDate',
          'endDate',
          'versionNumber'
        ])
        && request.resource.data.filterSnapshot.keys().hasOnly([
          'scope',
          'clinicianId',
          'exportRoute',
          'startDate',
          'endDate',
          'versionNumber'
        ])
        && request.resource.data.filterSnapshot.scope is string
        && request.resource.data.filterSnapshot.clinicianId is string
        && request.resource.data.filterSnapshot.exportRoute in [
          'all',
          'web_print',
          'native_share',
          'file_created'
        ]
        && request.resource.data.filterSnapshot.startDate is string
        && request.resource.data.filterSnapshot.endDate is string
        && request.resource.data.filterSnapshot.versionNumber is string
        && request.resource.data.recordCount is int
        && request.resource.data.recordCount > 0
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.auditRecordIds is list
        && request.resource.data.auditRecordIds.size() == request.resource.data.recordCount
        && request.resource.data.auditRecordPaths is list
        && request.resource.data.auditRecordPaths.size() == request.resource.data.recordCount;
    }

    // Collection-group queries need an explicit recursive match even though
    // every individual audit record has an administrator-only nested match.
    // This grants no create, update, or delete capability.
    match /{path=**}/comparisonAuditExports/{auditExportId} {
      allow read: if isAdmin();
    }

    // The clinical review queue uses a collection-group query across all
    // content blocks. Keep this read path administrator-only; learner reads
    // remain governed by the course-specific published-content rule below.
    match /{path=**}/contentBlocks/{contentBlockId} {
      allow read: if isAdmin();
    }

    // Dashboard report manifests preserve the exact immutable audit-record set
    // and original filters behind the report ID printed in the PDF.
    match /auditReportManifests/{reportId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAuditReportManifest(reportId);
      allow update, delete: if false;
    }

    // Clinically reviewed curriculum is write-protected behind a server-side
    // admin workflow. Users may read only currently published material.
    match /courses/{courseId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if courseIsPublished(courseId) || isAdmin();
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if courseIsPublished(courseId) || isAdmin();
          allow write: if isAdmin();

          match /contentBlocks/{contentBlockId} {
            // A course may be published while individual revisions are still
            // in draft or review. Learners see only the blocks that have
            // themselves completed publication; administrators retain full
            // review-queue visibility.
            allow read: if (
              courseIsPublished(courseId)
              && resource.data.publicationState == 'published'
            ) || isAdmin();
            allow write: if isAdmin() && validClinicalContentBlock();

            match /versions/{versionId} {
              allow read: if isAdmin();
              allow create: if isAdmin() && validClinicalContentVersion(contentBlockId);
              allow update, delete: if false;
            }

            match /comparisonAuditExports/{auditExportId} {
              allow read: if isAdmin();
              allow create: if isAdmin()
                && validComparisonAuditExport(
                  courseId,
                  moduleId,
                  lessonId,
                  contentBlockId,
                  auditExportId
                );
              allow update, delete: if false;
            }
          }
        }
      }
    }

    match /sources/{sourceId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin() && validSourceRecord();
    }

    // Candidate URLs and their AI assessments are never learner-visible. A
    // clinician can submit a candidate and document an editorial disposition;
    // the trusted worker alone creates assessment snapshots or changes an
    // evaluation state. The Admin SDK bypasses rules for that narrow job.
    match /mediaIntakes/{intakeId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validMediaIntakeCreate();
      allow update: if isAdmin() && validMediaIntakeDisposition();
      allow delete: if false;

      match /analyses/{analysisId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Clinical figures, images, audio, and video assets have the same
    // published-only learner visibility and administrator-only governance
    // model as clinical source records.
    match /clinicalMedia/{mediaId} {
      allow read: if resource.data.publicationState == 'published' || isAdmin();
      allow write: if isAdmin() && validClinicalMediaRecord(mediaId);

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && validClinicalMediaVersion(mediaId);
        allow update, delete: if false;
      }
    }

    match /clinicalMediaReviews/{reviewId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validClinicalMediaReview();
      allow update, delete: if false;
    }

    match /clinicalReviews/{reviewId} {
      allow read, write: if isAdmin();
    }

    // All user-owned data stays in a user namespace to make ownership explicit.
    match /users/{userId} {
      allow read, write: if owns(userId);

      match /courseProgress/{progressId} {
        allow read, write: if owns(userId);
      }

      match /planArtifacts/{artifactId} {
        allow read, write: if owns(userId);
      }

      match /careTeamContacts/{contactId} {
        allow read, write: if owns(userId);
      }

      // A learner owns one tightly bounded private planning record. On create,
      // both timestamps must be server timestamps (request.time); on update,
      // createdAt is immutable and updatedAt must again be server-generated.
      match /birthReadinessBriefs/{briefId} {
        allow read: if owns(userId) && briefId == 'preparing-for-labor';
        allow create: if owns(userId)
          && briefId == 'preparing-for-labor'
          && validBirthReadinessBriefData()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if owns(userId)
          && briefId == 'preparing-for-labor'
          && validBirthReadinessBriefData()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readinessItems', 'discussionQuestions', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(userId) && briefId == 'preparing-for-labor';
      }

      // Reflection answers from the class player, one private document per
      // reflection slide, named {lessonId}__{slideId}. Text is bounded and
      // updatedAt must be server-generated.
      match /birthReadinessReflections/{reflectionId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId) && validBirthReadinessReflection(reflectionId);
      }

      // Safety events should be written only by a trusted server process.
      match /safetyEvents/{eventId} {
        allow read: if owns(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Support sharing is scope-limited and must never open a user’s private
    // health record, private AI chats, or unshared plan artifacts.
    match /supportInvites/{inviteId} {
      allow read: if sharedWithCurrentUser() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.guestId is string;
      // Owners may manage scope and revoke access, but cannot silently replace
      // either party. Guests can only accept or decline their own invitation.
      allow update: if isAdmin()
        || (inviteOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.guestId == resource.data.guestId)
        || (inviteGuest()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt'])
          && request.resource.data.status in ['accepted', 'declined']);
      allow delete: if inviteOwner() || isAdmin();
    }
  }
}
