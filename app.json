{
  "expo": {
    "name": "BabyReady Virtual Educator",
    "slug": "babyready",
    "scheme": "babyready",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow BabyReady to use the microphone so you can ask your instructor questions out loud.",
          "speechRecognitionPermission": "Allow BabyReady to turn your spoken questions into text so your instructor can answer them."
        }
      ],
      [
        "./plugins/withAndroidAppLabel",
        {
          "label": "BabyReady VE"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brkservices.babyready",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "BabyReady VE"
      }
    },
    "android": {
      "package": "com.brkservices.babyready",
      "adaptiveIcon": {
        "backgroundColor": "#01696F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "shortName": "BabyReady VE"
    },
    "extra": {
      "eas": {
        "projectId": "c2757329-c18e-412c-9a95-b6b4ba19ae42"
      }
    }
  }
}
