# Copy this file to .env for a production export, or provide these values
# through the deployment environment. These are public Firebase web-app values,
# not service-account credentials.

FIREBASE_PROJECT_ID=babyready-8bfd6
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=babyready-8bfd6
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Production builds must never target the Local Emulator Suite.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
